{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Feynman tools-10 full-runner MCP artifact binding v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "verdict": {"const": "full-runner-mcp-artifact-chain-bound"},
    "run_id": {"type": "string", "minLength": 1},
    "case_id": {"const": "tools-10"},
    "condition_id": {"enum": ["baseline", "feynman-v05"]},
    "model": {"type": "string", "minLength": 1},
    "codex_cli": {"type": "string", "minLength": 1},
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runner_job_sha256": {"$ref": "#/$defs/sha256"},
        "boundary_profile_sha256": {"$ref": "#/$defs/sha256"},
        "eval_plan_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_prompt_sha256": {"$ref": "#/$defs/sha256"},
        "runtime_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      },
      "required": ["runner_job_sha256", "boundary_profile_sha256", "eval_plan_sha256", "candidate_prompt_sha256", "runtime_sha256"]
    },
    "native_windows_mapping": {"type": "object"},
    "declared_runner_boundary": {"type": "object"},
    "full_runner": {"type": "object"},
    "checks": {"type": "object"},
    "preflight_evidence": {"type": "object"},
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "credential_files_read": {"const": false},
        "control_codex_home_read": {"const": false},
        "candidate_task_payload_read": {"const": false},
        "model_request_started": {"const": false},
        "tool_payloads_preserved": {"const": false}
      },
      "required": ["credential_files_read", "control_codex_home_read", "candidate_task_payload_read", "model_request_started", "tool_payloads_preserved"]
    },
    "scope": {"type": "string", "minLength": 1}
  },
  "required": ["schema_version", "verdict", "run_id", "case_id", "condition_id", "model", "codex_cli", "lineage", "native_windows_mapping", "declared_runner_boundary", "full_runner", "checks", "preflight_evidence", "privacy", "scope"],
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
