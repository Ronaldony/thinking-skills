{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Feynman control-plane network canary reference",
  "type": "object",
  "properties": {
    "schema_version": {"const": 1},
    "host": {"type": "string", "minLength": 1},
    "port": {"type": "integer", "minimum": 1, "maximum": 65535},
    "reachable_from_control_plane": {"const": true},
    "probe_method": {"type": "string", "minLength": 1},
    "endpoint_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "required": ["schema_version", "host", "port", "reachable_from_control_plane"],
  "additionalProperties": false
}
