{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Feynman real-model run readiness artifact",
  "description": "Credential-free pre-run proof that a frozen job is structurally ready up to the operator-controlled model credential boundary. This is not a model-run or behavioral result.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "verdict": {"const": "ready-for-control-plane-auth"},
    "run_id": {"type": "string", "minLength": 1},
    "job": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1},
        "case_id": {"type": "string", "minLength": 1},
        "condition_id": {"enum": ["baseline", "generic", "legacy-clean", "feynman-v05"]},
        "repeat": {"type": "integer", "minimum": 1},
        "has_followup": {"type": "boolean"}
      },
      "required": ["ordinal", "case_id", "condition_id", "repeat", "has_followup"]
    },
    "versions": {
      "type": "object",
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "codex_cli": {"type": "string", "minLength": 1}
      },
      "required": ["model", "codex_cli"]
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {"const": "control-plane-only"},
        "credential_source": {"const": "environment"},
        "credential_env_key_name": {"$ref": "#/$defs/env_key"},
        "credential_value_read_by_preflight": {"const": false},
        "candidate_auth_exposed": {"const": false}
      },
      "required": [
        "mode",
        "credential_source",
        "credential_env_key_name",
        "credential_value_read_by_preflight",
        "candidate_auth_exposed"
      ]
    },
    "digests": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "eval_plan_sha256": {"$ref": "#/$defs/sha256"},
        "evaluator_case_sha256": {"$ref": "#/$defs/sha256"},
        "runner_job_sha256": {"$ref": "#/$defs/sha256"},
        "boundary_profile_sha256": {"$ref": "#/$defs/sha256"},
        "remote_environment_sha256": {"$ref": "#/$defs/sha256"},
        "control_config_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_task_sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": [
        "eval_plan_sha256",
        "evaluator_case_sha256",
        "runner_job_sha256",
        "boundary_profile_sha256",
        "remote_environment_sha256",
        "control_config_sha256",
        "candidate_task_sha256"
      ]
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runner_job_valid": {"const": true},
        "frozen_plan_job_match": {"const": true},
        "candidate_task_bytes_match": {"const": true},
        "boundary_profile_valid": {"const": true},
        "remote_environment_valid": {"const": true},
        "real_model_control_config_valid": {"const": true},
        "candidate_skill_preflight_valid": {"const": true},
        "expected_candidate_skills": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "system_skill_roots_observed": {"type": "array", "items": {"type": "object"}}
      },
      "required": [
        "runner_job_valid",
        "frozen_plan_job_match",
        "candidate_task_bytes_match",
        "boundary_profile_valid",
        "remote_environment_valid",
        "real_model_control_config_valid",
        "candidate_skill_preflight_valid",
        "expected_candidate_skills",
        "system_skill_roots_observed"
      ]
    },
    "required_external_input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "control-plane-environment-credential"},
        "env_key_name": {"$ref": "#/$defs/env_key"},
        "value_must_not_be_written_to_repository_or_candidate_artifacts": {"const": true}
      },
      "required": [
        "kind",
        "env_key_name",
        "value_must_not_be_written_to_repository_or_candidate_artifacts"
      ]
    },
    "next_required_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "scope": {"type": "string", "minLength": 1}
  },
  "required": [
    "schema_version",
    "verdict",
    "run_id",
    "job",
    "versions",
    "authentication",
    "digests",
    "preflight",
    "required_external_input",
    "next_required_evidence",
    "scope"
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "env_key": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
  }
}
