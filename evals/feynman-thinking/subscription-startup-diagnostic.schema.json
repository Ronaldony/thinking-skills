{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Feynman subscription startup diagnostic v3",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 3},
    "preparation_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "verdict": {"enum": ["subscription-startup-thread-ready", "subscription-startup-thread-blocked"]},
    "failure_stage": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "model": {"type": "string", "minLength": 1},
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "thread_started": {"type": "boolean"},
        "error_code": {"type": ["integer", "null"]},
        "error_category": {
          "enum": ["remote-path-error", "remote-environment-error", "mcp-startup-error", "model-configuration-error", "authentication-error", "configuration-error", "internal-error", null]
        },
        "error_signals": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mentions_environment": {"type": "boolean"},
            "mentions_exec_server": {"type": "boolean"},
            "mentions_connection": {"type": "boolean"},
            "mentions_initialize": {"type": "boolean"},
            "mentions_exit": {"type": "boolean"},
            "mentions_closed": {"type": "boolean"},
            "mentions_timeout": {"type": "boolean"},
            "mentions_config": {"type": "boolean"},
            "mentions_path": {"type": "boolean"},
            "mentions_not_found": {"type": "boolean"}
          },
          "required": ["mentions_environment", "mentions_exec_server", "mentions_connection", "mentions_initialize", "mentions_exit", "mentions_closed", "mentions_timeout", "mentions_config", "mentions_path", "mentions_not_found"]
        },
        "error_data_kind": {
          "enum": ["none", "boolean", "string", "number", "array", "object", "other"]
        },
        "ephemeral_thread": {"type": "boolean"},
        "instruction_sources_present": {"type": "boolean"},
        "instruction_sources_allowed": {"type": "boolean"},
        "response_payload_preserved": {"const": false},
        "initialize_completed": {"type": "boolean"},
        "turn_requests_sent": {"const": 0},
        "model_generation_requests_sent": {"const": 0},
        "process_tree_reaped": {"type": "boolean"},
        "cleanup_verified": {"type": "boolean"},
        "proxy_telemetry_complete": {"type": "boolean"},
        "proxy_request_response_correlated": {"type": "boolean"},
        "request_mapping_clean": {"type": "boolean"}
      },
      "required": ["thread_started", "error_code", "error_category", "ephemeral_thread", "instruction_sources_present", "instruction_sources_allowed", "response_payload_preserved", "initialize_completed", "turn_requests_sent", "model_generation_requests_sent", "process_tree_reaped", "cleanup_verified", "proxy_telemetry_complete", "proxy_request_response_correlated", "request_mapping_clean"]
    },
    "notification_methods": {"$ref": "#/$defs/safe_notification_counters"},
    "proxy_telemetry_status": {"enum": ["available", "missing"]},
    "proxy_telemetry": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": 3},
        "request_methods": {"$ref": "#/$defs/safe_method_counters"},
        "response_error_codes": {"$ref": "#/$defs/counters"},
        "requests_seen": {"$ref": "#/$defs/count"},
        "requests_forwarded": {"$ref": "#/$defs/count"},
        "request_write_failures": {"$ref": "#/$defs/count"},
        "request_id_duplicates": {"$ref": "#/$defs/count"},
        "request_mapping_rejections": {"$ref": "#/$defs/count"},
        "request_mapping_rejection_methods": {"$ref": "#/$defs/rejection_method_counters"},
        "request_mapping_rejection_reasons": {"$ref": "#/$defs/safe_reason_counters"},
        "request_mapping_rejection_method_reasons": {
          "type": "object",
          "propertyNames": {"enum": ["unknown", "command/exec", "process/exec", "process/start", "environmentConfig/read", "fs/canonicalize", "fs/getMetadata", "fs/walk", "fs/readFile", "fs/writeFile", "resources/read"]},
          "additionalProperties": {"$ref": "#/$defs/safe_reason_counters"}
        },
        "request_mapping_rejection_method_reason_fields": {
          "type": "object",
          "propertyNames": {"enum": ["unknown", "command/exec", "process/exec", "process/start", "environmentConfig/read", "fs/canonicalize", "fs/getMetadata", "fs/walk", "fs/readFile", "fs/writeFile", "resources/read"]},
          "additionalProperties": {
            "type": "object",
            "propertyNames": {"enum": ["unsupported-file-uri", "unsupported-file-uri-components", "host-path-not-absolute", "host-path-traversal", "invalid-host-path", "host-path-outside-declared-mount", "container-path-not-absolute", "container-path-traversal", "invalid-container-path", "container-path-outside-declared-mount", "invalid-container-file-uri", "invalid-path-field-type", "invalid-path-array-shape", "ambiguous-relative-environment-path", "unsafe-relative-environment-path", "candidate-mount-not-declared", "malformed-request", "probe-method-not-allowed", "probe-read-path-type", "probe-config-policy", "probe-filesystem-path-policy", "invalid-request-structure", "unclassified"]},
            "additionalProperties": {"$ref": "#/$defs/safe_field_counters"}
          }
        },
        "malformed_requests": {"$ref": "#/$defs/count"},
        "responses_seen": {"$ref": "#/$defs/count"},
        "responses_forwarded": {"$ref": "#/$defs/count"},
        "responses_matched": {"$ref": "#/$defs/count"},
        "responses_unmatched": {"$ref": "#/$defs/count"},
        "notifications_seen": {"$ref": "#/$defs/count"},
        "pending_request_ids": {"$ref": "#/$defs/count"},
        "response_mapping_rejections": {"$ref": "#/$defs/count"},
        "malformed_responses": {"$ref": "#/$defs/count"},
        "probe_policy_rejections": {"$ref": "#/$defs/count"},
        "probe_read_limit_applied": {"$ref": "#/$defs/count"},
        "probe_response_rejections": {"$ref": "#/$defs/count"},
        "probe_rejected_read_max_bytes": {"$ref": "#/$defs/count"},
        "child_exit_code": {"type": ["integer", "null"]},
        "child_stderr_bytes": {"$ref": "#/$defs/count"},
        "child_stderr_nonempty": {"type": "boolean"},
        "child_stderr_truncated": {"type": "boolean"},
        "child_stderr_read_error": {"type": "boolean"},
        "child_stderr_drained": {"type": "boolean"}
      },
      "required": ["schema_version", "request_methods", "response_error_codes", "requests_seen", "requests_forwarded", "request_write_failures", "request_id_duplicates", "request_mapping_rejections", "request_mapping_rejection_methods", "request_mapping_rejection_reasons", "request_mapping_rejection_method_reasons", "request_mapping_rejection_method_reason_fields", "malformed_requests", "responses_seen", "responses_forwarded", "responses_matched", "responses_unmatched", "notifications_seen", "pending_request_ids", "response_mapping_rejections", "malformed_responses", "probe_policy_rejections", "probe_read_limit_applied", "probe_response_rejections", "probe_rejected_read_max_bytes", "child_exit_code"]
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_or_response_payload_preserved": {"const": false},
        "thread_id_preserved": {"const": false},
        "instruction_source_paths_preserved": {"const": false},
        "raw_stderr_preserved": {"const": false},
        "credential_files_directly_read_by_probe": {"const": false},
        "control_home_contents_serialized": {"const": false}
      },
      "required": ["request_or_response_payload_preserved", "thread_id_preserved", "instruction_source_paths_preserved", "raw_stderr_preserved", "credential_files_directly_read_by_probe", "control_home_contents_serialized"]
    },
    "scope": {"type": "string", "minLength": 1}
  },
  "required": ["schema_version", "verdict", "model", "checks", "notification_methods", "proxy_telemetry_status", "proxy_telemetry", "privacy", "scope"],
  "allOf": [{
    "if": {
      "required": ["verdict"],
      "properties": {"verdict": {"const": "subscription-startup-thread-ready"}}
    },
    "then": {"required": ["preparation_fingerprint"]}
  }],
  "$defs": {
    "count": {"type": "integer", "minimum": 0},
    "counters": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/count"}
    },
    "safe_method_counters": {
      "type": "object",
      "propertyNames": {"enum": ["unknown", "initialize", "initialized", "thread/start", "environment/info", "command/exec", "process/exec", "process/start", "environmentConfig/read", "fs/canonicalize", "fs/getMetadata", "fs/walk", "fs/readFile", "fs/writeFile", "resources/read"]},
      "additionalProperties": {"$ref": "#/$defs/count"}
    },
    "rejection_method_counters": {
      "type": "object",
      "propertyNames": {"enum": ["unknown", "command/exec", "process/exec", "process/start", "environmentConfig/read", "fs/canonicalize", "fs/getMetadata", "fs/walk", "fs/readFile", "fs/writeFile", "resources/read"]},
      "additionalProperties": {"$ref": "#/$defs/count"}
    },
    "safe_reason_counters": {
      "type": "object",
      "propertyNames": {"enum": ["unsupported-file-uri", "unsupported-file-uri-components", "host-path-not-absolute", "host-path-traversal", "invalid-host-path", "host-path-outside-declared-mount", "container-path-not-absolute", "container-path-traversal", "invalid-container-path", "container-path-outside-declared-mount", "invalid-container-file-uri", "invalid-path-field-type", "invalid-path-array-shape", "ambiguous-relative-environment-path", "unsafe-relative-environment-path", "candidate-mount-not-declared", "malformed-request", "probe-method-not-allowed", "probe-read-path-type", "probe-config-policy", "probe-filesystem-path-policy", "invalid-request-structure", "unclassified"]},
      "additionalProperties": {"$ref": "#/$defs/count"}
    },
    "safe_field_counters": {
      "type": "object",
      "propertyNames": {"enum": ["unknown", "cwd", "path", "uri", "configPaths", "requirementsPaths"]},
      "additionalProperties": {"$ref": "#/$defs/count"}
    },
    "safe_notification_counters": {
      "type": "object",
      "propertyNames": {"enum": ["unknown", "configWarning", "environment/connection", "environment/connection/updated", "error", "thread/closed", "thread/environment/connected", "thread/environment/disconnected", "thread/started", "thread/status/changed", "warning"]},
      "additionalProperties": {"$ref": "#/$defs/count"}
    }
  }
}
